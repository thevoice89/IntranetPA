# Copiare in "deploy/vps/.env" (in locale e sulla VM).
# Docker Compose legge il .env accanto al file passato con -f: DEVE stare in
# deploy/vps/.env, non nella root del progetto.

# --- Indirizzo pubblico -------------------------------------------------
# Host servito da Traefik (senza protocollo).
SITE_HOST=intranet.example.it
# Stesso host in forma di URL, senza slash finale (usato nei link delle email).
APP_BASE_URL=https://intranet.example.it

# --- Password condivisa dai dipendenti (basic auth Traefik) -------------
# ATTENZIONE: nell'hash bcrypt i "$" vanno RADDOPPIATI, anche qui nel .env.
# Docker Compose interpreta i "$" come variabili pure nei valori letti dal
# .env: con i "$" singoli l'hash arriva troncato a "dipendenti:$2y$05" e la
# password non funziona mai (verificato il 2026-09-03 con docker compose config).
# Comando che genera l'hash gia' pronto da incollare:
#   docker run --rm httpd:2.4-alpine htpasswd -nbB dipendenti 'LA_PASSWORD' | sed 's/\$/$$/g'
BASIC_AUTH_USERS=dipendenti:$$2y$$05$$SOSTITUIRE_CON_HASH_HTPASSWD

# --- Database -----------------------------------------------------------
# Mantenere gli stessi valori del server comunale semplifica il restore.
POSTGRES_USER=intranet
POSTGRES_PASSWORD=metti_una_password_lunga_e_casuale
POSTGRES_DB=intranet

# --- Applicazione -------------------------------------------------------
ADMIN_PASSWORD=password_del_pannello_admin
# openssl rand -hex 32
SESSION_SECRET=
# Token per i cron di sync (/api/presenze/sync), diverso
# da SESSION_SECRET.  openssl rand -hex 32
SYNC_TOKEN=
# openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# --- SMTP (es. Gmail; modificabile anche da /admin/impostazioni) ------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

