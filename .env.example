# Copiare in ".env" e personalizzare. NON committare il file .env reale.
# Configurazione per RETE LOCALE (accesso via http://IP_DELLA_VM/).

# Credenziali PostgreSQL
POSTGRES_USER=intranet
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=intranet

# Pannello admin (/admin). Usata solo al primo avvio, per creare l'utente
# "admin": in produzione è obbligatoria (nessun ripiego su "admin").
ADMIN_PASSWORD=scegli_una_password_admin
# Segreto per firmare i cookie di sessione (stringa lunga e casuale).
# Obbligatorio in produzione: senza, il login fallisce con un errore nei log.
# Generane uno con:  openssl rand -hex 32
SESSION_SECRET=cambia_con_una_stringa_casuale_lunga

# Token per le route chiamate dai cron (/api/presenze/sync):
# header "Authorization: Bearer <SYNC_TOKEN>". Tenerlo diverso da
# SESSION_SECRET. Se vuoto, per compatibilità vale ancora SESSION_SECRET.
# Generane uno con:  openssl rand -hex 32
SYNC_TOKEN=

# Chiave (base64, 32 byte) per stabilizzare gli ID delle Server Action tra i
# deploy. Generane una con:  openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=cambia_con_una_chiave_base64

# Integrazione Sicraweb EVO (Maggioli) — sync presenze da timbrature (vedi
# /admin/presenze e /api/presenze/sync). Credenziali fornite da Maggioli.
SICRAWEB_HOST=https://ENTE.sicraweb.maggioli.cloud
SICRAWEB_ALIAS=
SICRAWEB_USERNAME=
SICRAWEB_PASSWORD=
SICRAWEB_COD_ENTE=C0

# URL pubblico dell'Intranet (usato per costruire link cliccabili nelle email,
# es. http://192.168.1.10). Senza protocollo/slash finale.
APP_BASE_URL=

# Invio email di notifica quando arriva una nuova compilazione di un modulo
# (vedi campo "Email di notifica" nell'editor del modulo). Se SMTP_HOST resta
# vuoto, le notifiche vengono semplicemente saltate (nessun errore).
# Qualunque provider SMTP AUTH va bene (Office 365, Aruba, PEC, ecc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
